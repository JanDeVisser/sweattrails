// SweatTrails' built-in dashboard for rides, and an example to copy: put
// your own layouts in `overlays/` in SweatTrails' data folder, named
// `<name>.overlay.json`. The format is in specs/overlay-layout.md.
{
    "version": 1,
    "design_size": { "width": 1920, "height": 1080 },
    "units": "metric",
    "defaults": {
        "font": "Inter-Bold.ttf",
        "font_size": 64,
        "color": "#ffffff",
        "shadow": { "color": "#00000080", "offset": [2, 2] }
    },
    "styles": {
        "panel": { "background": "#00000060", "radius": 16,
                   "border": { "color": "#ffffff30", "width": 1 } },
        "label": { "font": "Inter-Regular.ttf", "font_size": 22, "color": "#ffffffcc" },
        "line": { "font_size": 40 },
        "unit": { "unit_style": { "font": "Inter-Regular.ttf", "font_size": 28 } },
        // For the first 5 seconds of the video, fading in and out.
        "title_card": { "visible": { "to": 5 }, "fade": 0.5 }
    },
    "elements": [
        // The distance and the times in the top left, in a panel. A
        // group's children are placed in its box.
        { "type": "group", "style": "panel",
          "at": { "x": 40, "y": 40 }, "size": { "width": 320, "height": 170 },
          "children": [
            { "type": "text", "text": "{distance:.1f} {distance.unit}", "style": "line",
              "at": { "x": 24, "y": 16 } },
            { "type": "text", "text": "{elapsed}", "style": "line",
              "at": { "x": 24, "y": 66 } },
            { "type": "text", "text": "{time_of_day:hms}", "style": "label",
              "at": { "x": 24, "y": 122 } }
          ] },

        // The elevation of the whole ride across the top, with where the
        // rider is. "extent": "lap" shows the lap instead, for a ride split
        // into climbs.
        { "type": "profile", "extent": "all",
          "done": { "line": { "color": "#ffb703", "width": 3 }, "fill": "#ffb70360" },
          "remaining": { "line": { "color": "#ffffff", "width": 2 }, "fill": "#ffffff20" },
          "marker": { "color": "#ffffff", "radius": 7, "outline": "#ffb703", "drop_line": true },
          "marker_label": { "text": "{altitude:.0f} {altitude.unit} · {grade:+.1f}%", "style": "label" },
          "axis_labels": { "min_max": true, "style": "label" },
          "laps": { "color": "#ffffff60", "width": 1 },
          "style": "panel", "padding": 12,
          "at": { "x": "50%", "y": 40, "anchor": "top" },
          "size": { "width": 900, "height": 120 } },

        // The track in the top right, following the rider, in the
        // profile's colors.
        { "type": "map", "view": "follow", "zoom": 15, "clip": "circle",
          "background": "#00000060", "border": { "color": "#ffffff40", "width": 2 },
          "track": { "done": { "color": "#ffb703", "width": 5 },
                     "remaining": { "color": "#ffffff80", "width": 3 },
                     "outline": { "color": "#00000080", "width": 2 } },
          "marker": { "color": "#ffffff", "radius": 8, "outline": "#ffb703" },
          "tiles": { "opacity": 0.6, "filter": "dark" },
          "attribution": { "style": "label", "font_size": 14 },
          "at": { "x": -40, "y": 40, "anchor": "top-right" },
          "size": { "width": 300, "height": 300 } },

        // The last minute of heart rate, ending at the moment.
        { "type": "graph", "field": "heart_rate", "x_axis": "time", "window": 60,
          "line": { "color": "#f94144", "width": 3 }, "fill": "#f9414430",
          "cursor": { "color": "#ffffff", "radius": 6 },
          "style": "panel", "padding": 16,
          "at": { "x": 40, "y": -230, "anchor": "bottom-left" },
          "size": { "width": 760, "height": 140 } },

        // Speed, heart rate and cadence in the bottom left, in a panel,
        // from its bottom: a negative y is from the bottom of the group.
        // Each label has an icon before it, in the color of what it's for.
        { "type": "group", "style": "panel",
          "at": { "x": 40, "y": -40, "anchor": "bottom-left" }, "size": { "width": 760, "height": 170 },
          "children": [
            { "type": "image", "src": "icons/speedometer.png", "tint": "#ffffffcc",
              "at": { "x": 30, "y": -112, "anchor": "bottom-left" }, "size": { "width": 24 } },
            { "type": "text", "text": "SPEED", "style": "label",
              "at": { "x": 62, "y": -110, "anchor": "bottom-left" } },
            { "type": "value", "field": "speed", "style": "unit",
              "at": { "x": 30, "y": -20, "anchor": "bottom-left" } },
            { "type": "image", "src": "icons/heart.png", "tint": "#f94144",
              "at": { "x": 290, "y": -112, "anchor": "bottom-left" }, "size": { "width": 24 } },
            { "type": "text", "text": "HEART RATE", "style": "label",
              "at": { "x": 322, "y": -110, "anchor": "bottom-left" } },
            { "type": "value", "field": "heart_rate", "style": "unit",
              "at": { "x": 290, "y": -20, "anchor": "bottom-left" } },
            { "type": "image", "src": "icons/cadence.png", "tint": "#ffffffcc",
              "at": { "x": 530, "y": -112, "anchor": "bottom-left" }, "size": { "width": 24 } },
            { "type": "text", "text": "CADENCE", "style": "label",
              "at": { "x": 562, "y": -110, "anchor": "bottom-left" } },
            { "type": "value", "field": "cadence", "style": "unit",
              "at": { "x": 530, "y": -20, "anchor": "bottom-left" } }
          ] },

        // Power as an arc in the bottom right, turning from blue to red as
        // it goes up, with the number in its middle.
        { "type": "gauge", "field": "power", "shape": "arc", "min": 0, "max": 400,
          "track": "#ffffff30", "thickness": 18,
          "color_by": { "thresholds": [[0, "#8ecae6"], [150, "#90be6d"], [220, "#f9c74f"], [300, "#f94144"]] },
          "style": "panel", "padding": 20,
          "at": { "x": -40, "y": -40, "anchor": "bottom-right" },
          "size": { "width": 240, "height": 240 } },
        { "type": "value", "field": "power", "style": "unit",
          "at": { "x": -160, "y": -160, "anchor": "center" } },
        { "type": "image", "src": "icons/bolt.png", "tint": "#f9c74f",
          "at": { "x": -210, "y": -92, "anchor": "left" }, "size": { "width": 24 } },
        { "type": "text", "text": "POWER", "style": "label",
          "at": { "x": -144, "y": -92, "anchor": "center" } },

        // The ride's name and date in the middle, at the start of the
        // video, with room for a title of some 50 characters. The group
        // shows and fades, and its children with it.
        { "type": "group", "style": ["title_card", "panel"],
          "at": { "x": "50%", "y": "50%", "anchor": "center" }, "size": { "width": 1400, "height": 200 },
          "children": [
            { "type": "text", "text": "{title}", "font_size": 48,
              "at": { "x": "50%", "y": "50%", "anchor": "bottom" } },
            { "type": "text", "text": "{date}", "style": "label", "font_size": 28,
              "at": { "x": "50%", "y": 121.6, "anchor": "top" } }
          ] }
    ]
}
